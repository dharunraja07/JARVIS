# ==============================================================================
# J.A.R.V.I.S. SYSTEM ENVIRONMENT CONFIGURATION
# Copy this file to .env.local (for local dev) or set in Cloud Host (Render/Railway)
# ==============================================================================

# --- LiveKit WebRTC Cloud Credentials ---
# Obtained from LiveKit Cloud Console (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Multi-Device Security & Pairing Keys ---
# High-entropy secret keys for web client authentication & companion pairing
JARVIS_AUTH_KEY=your-secure-random-master-key-here
JARVIS_DEVICE_SECRET=your-secure-random-device-secret-here
JARVIS_ENV=production

# --- Cloud Database (PostgreSQL) ---
# If unset, local SQLite database (src/database/jarvis_memory.db) will be used automatically.
# Set for persistent cloud storage on Render, Neon, Supabase, or AWS RDS:
# DATABASE_URL=postgresql://user:password@ep-host.region.neon.tech/jarvis_memory?sslmode=require

# --- Server Binding & Networking ---
JARVIS_CLOUD_HOST=0.0.0.0
JARVIS_CLOUD_PORT=8000
# On cloud platforms (Render, Railway), PORT is assigned dynamically by the host.

# --- CORS Allowed Origins ---
# Comma-separated list of allowed frontend origins (e.g. Vercel URL, custom domain, localhost)
JARVIS_ALLOWED_ORIGINS=https://your-jarvis.vercel.app,http://localhost:5173,http://localhost:4173

# --- Windows Local Companion Configuration ---
# Configured on your Windows laptop/workstation running src/windows_companion.py:
JARVIS_CLOUD_URL=https://your-cloud-gateway.onrender.com
JARVIS_DEVICE_ID=windows-companion
JARVIS_COMPANION_PORT=8001
